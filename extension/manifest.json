{
  "manifest_version": 3,
  "name": "Load Offer Auto-Reply (lmc -d)",
  "version": "1.0.0",
  "description": "Google Chat: recognizes load offers from brokers and instantly replies \"lmc -d\".",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Load Offer Auto-Reply",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["detector.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
